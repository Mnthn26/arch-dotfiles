{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 8,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "tray", "cpu", "memory", "backlight", "pulseaudio", "network", "battery", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": { "*": 5 },
        "on-click": "activate"
    },

    "clock": {
        "format": "َ°¥”  {:%a %b %d   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": { "today": "<span color='#89b4fa'><b><u>{}</u></b></span>" }
        }
    },

    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "{status_icon} <i>{artist} - {title}</i>",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "spotify": "",
            "chromium": "",
            "chrome": "",
            "firefox": ""
        },
        "status-icons": {
            "paused": ""
        },
        "tooltip-format": "{player} - {title}\n{artist}\n{album}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "tray": { "icon-size": 16, "spacing": 10 },

    "cpu": { "format": "َ°»  {usage}%", "interval": 3, "on-click": "kitty -e btop" },

    "memory": {
        "format": "َ°چ› {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["َ°ƒ‍", "َ°ƒں", "َ°ƒ "],
        "on-scroll-up": "swayosd-client --brightness raise",
        "on-scroll-down": "swayosd-client --brightness lower"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "َ°‌ں muted",
        "format-icons": ["َ°•؟", "َ°–€", "َ°•¾"],
        "on-click": "pavucontrol",
        "on-click-right": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },

    "network": {
        "format-wifi": "َ°¤¨ {signalStrength}%",
        "format-ethernet": "َ°ˆ€ wired",
        "format-disconnected": "َ°¤® offline",
        "tooltip-format-wifi": "{essid}\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}",
        "on-click": "kitty -e nmtui"
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "َ°‚„ {capacity}%",
        "format-plugged": "َ°ڑ¥ {capacity}%",
        "format-icons": ["َ°پ؛", "َ°پ¼", "َ°پ¾", "َ°‚€", "َ°‚‚", "َ°پ¹"]
    },

    "custom/power": {
        "format": "َ°گ¥",
        "tooltip": false,
        "on-click": "~/.config/waybar/power.sh"
    }
}
